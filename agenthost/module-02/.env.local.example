# Copy to .env.local in the initialized maf-agent directory.
# This file uses shell syntax and is loaded by run-local.sh before azd starts.
# Leave settings commented out to use existing machine configuration.
# Keep credentials in your local configuration or credential provider.

# A default Python package index shared by uv and pip.
# AGENT_PYTHON_INDEX_URL="https://packages.example.com/pypi/simple/"

# Standard proxy settings are inherited by the installers and agent process.
# HTTPS_PROXY="http://proxy.example.com:8080"
# HTTP_PROXY="http://proxy.example.com:8080"
# NO_PROXY="localhost,127.0.0.1,::1"

# Use your organization's CA bundle when required; keep TLS verification on.
# SSL_CERT_FILE="/absolute/path/to/company-ca-bundle.pem"
# PIP_CERT="$SSL_CERT_FILE"
# REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"

# Optional local wheels, compatible with this machine's OS, CPU and Python.
# Relative paths are resolved from the initialized maf-agent directory.
# AGENT_WHEELHOUSE="./wheelhouse"

# Disable package-index access (Azure API access is still required by the agent).
# Supply all Python dependencies in AGENT_WHEELHOUSE or the installer cache.
# Preinstall Python 3.13+ before enabling this setting.
# AGENT_PACKAGES_OFFLINE=true
