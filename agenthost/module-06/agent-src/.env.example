# Copy to .env. Never commit the populated file.
# Compose pulls ACR-built images; this is the login server, not the ACR resource name.
ACR_LOGIN_SERVER=
IMAGE_TAG=latest
# Both Azure providers use the same PostgreSQL/pgvector repository.
# horizondb (default) or postgresql (Azure PostgreSQL Flexible Server).
DB_PROVIDER=horizondb
DB_ENDPOINT=localhost
DB_PORT=5432
DB_DATABASE=postgres
# password preserves local/alternate deployments. Azure Agents use entra with the Module-01 UAMI.
DB_AUTH_MODE=password
DB_USERNAME=studio
DB_PASSWORD=replace-with-a-local-database-password
# Entra: set DB_USERNAME to the UAMI name, omit DB_PASSWORD, and require TLS below.
# The administrator password file is provisioning-only; never deliver it to Entra Agent runtimes.
# disable is accepted ONLY for localhost/127.0.0.1/db. Azure: require or verify-full.
DB_SSL_MODE=disable
# UAMI client/application ID (not principal/object ID), selected explicitly for database tokens.
# Leave blank for local password mode; Azure runtime configuration supplies the Module-01 values.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
# Managed identity requires no AZURE_CLIENT_SECRET.
BLOB_BACKEND=local
LOCAL_BLOB_PATH=.local/data
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=data
# Cloud: Module-01 gateway API base, including /foundry (not /openai/v1).
# Example: https://apim-agenthost-<SN>.azure-api.net/foundry
AGENT_APIM_ENDPOINT=
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_OPENAI_BASE_URL=
# Cloud: deploy.sh --stage models provisions the route and emits <AGENT_APIM_ENDPOINT>/openai/v1.
# Local-only flows may explicitly supply a direct account v1 endpoint and its token scope.
FOUNDRY_EMBEDDING_BASE_URL=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
FOUNDRY_API_VERSION=v1
LLM_TOKEN_SCOPE=https://ai.azure.com/.default
EMBEDDING_TOKEN_SCOPE=https://ai.azure.com/.default
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Shared only by trusted Agent services; never enter it in the browser.
A2A_API_KEY=replace-with-a-random-peer-key
# Each service advertises its own reachable base URL, never another Agent's URL.
A2A_PUBLIC_URL=http://127.0.0.1:8080
ORCHESTRATOR_URL=http://127.0.0.1:8081
DATA_PROCESSING_URL=http://127.0.0.1:8082
RAG_URL=http://127.0.0.1:8083
SQL_URL=http://127.0.0.1:8084
MAX_UPLOAD_BYTES=20000000
MAX_ROWS=50000
# Total budget, not the in-memory batch size. Existing lower overrides still apply.
MAX_CHUNKS=100000
# Combined private temporary-file budget per active upload; free disk is also required.
MAX_INGESTION_SPOOL_BYTES=4294967296
# Keep equal across Agents. Normal questions still use REQUEST_TIMEOUT.
INGESTION_TIMEOUT=7200
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
EMBEDDING_BATCH=32
TOP_K=5
RELEVANCE_THRESHOLD=0.4
SQL_ROW_LIMIT=100
SQL_TIMEOUT_MS=5000
WORKER_TIMEOUT=120
REQUEST_TIMEOUT=600
MAX_MODEL_CONTEXT=24000
MAX_RUNS=200
REQUESTS_PER_MINUTE=60
