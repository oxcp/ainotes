# Azure Blob CSI persistence for the Module 3 agent runtime.
# prepare-agent-sandbox.sh replaces <RESOURCE_GROUP >, <STORAGE_ACCOUNT >,
# <KUBELET_CLIENT_ID >, and <NAMESPACE >.
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: agent-blob
provisioner: blob.csi.azure.com
reclaimPolicy: Retain
volumeBindingMode: Immediate
allowVolumeExpansion: true
mountOptions:
  - -o allow_other
  - --file-cache-timeout-in-seconds=120

---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: agent-state-blob
spec:
  capacity:
    # Blob containers do not enforce this size; Kubernetes requires a value.
    storage: 1Gi
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  storageClassName: agent-blob
  csi:
    driver: blob.csi.azure.com
    volumeHandle: <STORAGE_ACCOUNT>_agent-state
    volumeAttributes:
      protocol: fuse2
      resourceGroup: <RESOURCE_GROUP>
      storageAccount: <STORAGE_ACCOUNT>
      containerName: agent-state
      AzureStorageAuthType: MSI
      AzureStorageIdentityClientID: <KUBELET_CLIENT_ID>
  mountOptions:
    - -o allow_other
    - --file-cache-timeout-in-seconds=120

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: agent-state
  namespace: <NAMESPACE>
spec:
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 1Gi
  volumeName: agent-state-blob
  storageClassName: agent-blob