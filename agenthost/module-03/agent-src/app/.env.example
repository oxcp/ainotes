# app/.env.example — Environment configuration for main.py
# Copy to `.env` for local runs. In AKS most values are injected by agent-sandbox.yaml.

# ── Process / HTTP server ──────────────────────────────────────────────────
AGENT_ID=business-analysis-agent
AGENT_PORT=8080
AGENT_LOG_LEVEL=INFO

# ── HorizonDB persistence ──────────────────────────────────────────────────
# PostgreSQL connection string; keep credentials out of tracked files.
WRITE_DATABASE_URL=host=<primary-host> port=5432 dbname=postgres user=<user> password=<password> sslmode=require

# ── Model inference: Responses API through APIM ────────────────────────────
# main.py appends /openai/v1 to AGENT_APIM_ENDPOINT.
AGENT_APIM_ENDPOINT=https://apim-agenthost-<SN>.azure-api.net/foundry
#AGENT_APIM_ENDPOIN=
LLM_MODEL=gpt-5.4-mini

# ── Authentication / authorization ─────────────────────────────────────────
# The app uses DefaultAzureCredential (Workload Identity in AKS, developer login locally).
# This scope is used to fetch the Bearer token forwarded to APIM.
LLM_TOKEN_SCOPE=https://ai.azure.com/.default
