# Copy to .env and edit. Run all scripts from a Linux Bash environment.
RESOURCE_GROUP=rg-aks-agent-sandbox-lab
CLUSTER_NAME=aks-agent-sandbox-lab
# Default region; verify the preview release, v6 capacity and APIM availability.
LOCATION=eastus2
KUBERNETES_VERSION=1.35
NODEPOOL_NAME=katapool
VM_SIZE=Standard_D4as_v6
SYSTEM_NODE_COUNT=2
# Kata nodes are scaled manually; the cluster autoscaler is disabled.
KATA_NODE_COUNT=5
NAMESPACE=agent-lab
STORAGE_CONTAINER=pod-snapshots
# Provisioning builds agent-src with ACR Tasks and records its immutable digest.
IMAGE_REPOSITORY=agent-host
IMAGE_TAG=lab-v1
SERVICE_ACCOUNT=agent-sa
# Chat history stays in memory by default. Enabling this does not mount Blob.
CHAT_PERSISTENCE_ENABLED=false
# Foundry and AMR regions are independently configurable from LOCATION and each other.
FOUNDRY_LOCATION=westus3
AMR_LOCATION=westus3
FOUNDRY_PROJECT_NAME=sandbox-agent-prj
LLM_MODEL=gpt-5.4-mini
MODEL_VERSION=2026-03-17
MODEL_CAPACITY=50
# Semantic response cache: embeddings use Global Standard capacity; lower threshold is stricter.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=1
EMBEDDING_CAPACITY=30
SEMANTIC_CACHE_THRESHOLD=0.2
SEMANTIC_CACHE_TTL=300
# Optional publisher contact; the default requires no input (no credential or secret).
APIM_PUBLISHER_EMAIL=admin@example.com
APIM_PUBLISHER_NAME="AKS Agent Sandbox Lab"
TIMEOUT=10m
