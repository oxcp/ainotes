# app/.env.example — Environment configuration for main.py
# build-image.sh copies this to .env and replaces <API_BASE_URL> before ACR builds.
# Keep only non-secret defaults here; Kubernetes environment variables take precedence.

# ── Process / HTTP server ──────────────────────────────────────────────────
AGENT_ID=aks-agentsb
AGENT_PORT=8080
AGENT_LOG_LEVEL=INFO
# Run a short startup chat demo locally: true|false
AGENT_RUN_DEMO=true

# ── State persistence: mounted Blob volume ─────────────────────────────────
# The pod mounts the Blob container here; the app reads and writes
# <STATE_MOUNT_PATH>/<AGENT_ID>.json using normal file operations.
STATE_MOUNT_PATH=/app/app/data

# ── Model inference: Responses API through APIM ────────────────────────────
# main.py appends /openai/v1 to AGENT_APIM_ENDPOINT.
AGENT_APIM_ENDPOINT=<API_BASE_URL>
LLM_MODEL=gpt-5.4-mini
AGENT_INSTRUCTIONS=You are a concise, helpful assistant. Keep answers brief.

# ── Authentication / authorization ─────────────────────────────────────────
# The app uses DefaultAzureCredential (Workload Identity in AKS, developer login locally).
# This scope is used to fetch the Bearer token forwarded to APIM.
LLM_TOKEN_SCOPE=https://ai.azure.com/.default
